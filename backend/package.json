{
  "name": "dravyaguna-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "import:frontend": "node scripts/importFromFrontendDataset.js",
    "scale:herbs": "node scripts/scaleHerbsForBenchmark.js",
    "db:embedded": "node scripts/startEmbeddedPostgres.js",
    "seed": "node scripts/seed.js",
    "test": "node tests/run.js",
    "test:cleanup": "node scripts/testCleanup.js",
    "check:rls": "node scripts/checkRls.js",
    "admin:first": "node scripts/createFirstAdmin.js",
    "export:herbs": "node scripts/exportHerbs.js",
    "measure:search-concurrency": "node scripts/measureSearchConcurrency.js",
    "weights:reset": "node scripts/resetScoringWeights.js",
    "dev-users:passwords": "node scripts/setDevUserPasswords.js",
    "seed:dev-users:supabase-dev": "node scripts/seedDevUsers.js --supabase-dev",
    "staging:remove-dev-users": "node scripts/removeDevUsers.js",
    "loadtest:search": "node scripts/loadTestSearch.js",
    "explain:search": "node scripts/explainSearch.js",
    "rag:ingest": "node scripts/ingestKnowledge.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "node-pg-migrate": {
    "migrationFileExtension": ".cjs",
    "dir": "migrations",
    "databaseUrl": {
      "env": "DATABASE_URL"
    }
  }
}
